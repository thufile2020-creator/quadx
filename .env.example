# Copy to .env locally. Never commit .env.
FLASK_DEBUG=true
PORT=5000
JWT_SECRET_KEY=replace-with-a-long-random-secret
# SQLite by default: the database is automatically saved as ../database/carbonease.db
# Leave DATABASE_URL unset for this layout.
# DATABASE_URL=sqlite:////absolute/path/to/carbonease.db
# For MySQL instead (create DB first):
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/carbonease
# Comma-separated origins of local frontend development servers
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173,http://127.0.0.1:5173
